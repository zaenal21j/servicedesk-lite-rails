<!DOCTYPE html><html><head><title><%= content_for(:title) || "ServiceDesk Lite" %></title><meta name="viewport" content="width=device-width,initial-scale=1"><%= csrf_meta_tags %><%= csp_meta_tag %><%= stylesheet_link_tag :app, "data-turbo-track": "reload" %></head><body><% if current_user %><header class="topbar"><%= link_to root_path, class: "brand" do %><span>SD</span> ServiceDesk Lite<% end %><nav><%= link_to "Dashboard", root_path %><%= link_to "Customers", customers_path %><%= link_to "Tickets", tickets_path %></nav><div class="topbar-actions"><%= link_to "+ New ticket", new_ticket_path, class: "button button-small" %><%= button_to "Sign out", logout_path, method: :delete, class: "link-button" %></div></header><% end %><main class="shell <%= "login-shell" unless current_user %>"><% flash.each do |type, message| %><div class="flash <%= type %>"><%= message %></div><% end %><%= yield %></main></body></html>
