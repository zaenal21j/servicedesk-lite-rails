<div class="page-head"><div><p class="eyebrow">Ticket #<%= @ticket.id %></p><h1><%= @ticket.subject %></h1><p>For <%= link_to @ticket.customer.name, @ticket.customer %></p></div><%= link_to "Edit ticket", edit_ticket_path(@ticket), class: "button button-secondary" %></div><article class="detail-card"><div><span class="pill <%= @ticket.status %>"><%= @ticket.status.humanize %></span><span class="priority <%= @ticket.priority %>"><%= @ticket.priority %></span></div><p><%= simple_format @ticket.description %></p></article>
