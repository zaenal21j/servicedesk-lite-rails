<div class="page-head"><div><p class="eyebrow">Support queue</p><h1>Tickets</h1></div><%= link_to "+ New ticket", new_ticket_path, class: "button" %></div><%= form_with url: tickets_path, method: :get, class: "filters" do |form| %><%= form.search_field :q, value: params[:q], placeholder: "Search tickets..." %><%= form.select :status, [["All statuses", ""]] + Ticket::STATUSES.map { |v| [v.humanize, v] }, selected: params[:status] %><%= form.submit "Filter", class: "button button-small" %><% end %><section class="panel"><%= inline_partial("tickets/_table", tickets: @tickets) %></section>
