<% if tickets.any? %><div class="ticket-list"><% tickets.each do |ticket| %><%= link_to ticket, class: "ticket-row" do %><div><strong><%= ticket.subject %></strong><span><%= ticket.customer.name %></span></div><span class="pill <%= ticket.status %>"><%= ticket.status.humanize %></span><span class="priority <%= ticket.priority %>"><%= ticket.priority %></span><% end %><% end %></div><% else %><p class="empty">No tickets yet.</p><% end %>
