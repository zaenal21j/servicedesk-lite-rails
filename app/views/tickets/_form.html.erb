<%= form_with model: ticket, class: "form-card" do |form| %><% if ticket.errors.any? %><div class="errors"><%= ticket.errors.full_messages.to_sentence %></div><% end %><label>Customer<%= form.collection_select :customer_id, current_workspace.customers.order(:name), :id, :name, { selected: ticket.customer_id || params.dig(:ticket, :customer_id) }, required: true %></label><label>Subject<%= form.text_field :subject, required: true %></label><label>Description<%= form.text_area :description, rows: 7, required: true %></label><div class="form-grid"><label>Status<%= form.select :status, Ticket::STATUSES.map { |v| [v.humanize, v] } %></label><label>Priority<%= form.select :priority, Ticket::PRIORITIES.map { |v| [v.humanize, v] } %></label></div><%= form.submit class: "button" %><% end %>
