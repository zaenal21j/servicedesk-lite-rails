<div class="page-head"><div><p class="eyebrow">Directory</p><h1>Customers</h1></div><%= link_to "+ Add customer", new_customer_path, class: "button" %></div><section class="card-grid"><% @customers.each do |customer| %><%= link_to customer, class: "customer-card" do %><div class="avatar"><%= customer.name.first %></div><h3><%= customer.name %></h3><p><%= customer.company.presence || "Independent" %></p><span><%= pluralize(customer.tickets.size, "ticket") %></span><% end %><% end %></section>
