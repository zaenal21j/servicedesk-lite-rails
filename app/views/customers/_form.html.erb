<%= form_with model: customer, class: "form-card" do |form| %><% if customer.errors.any? %><div class="errors"><%= customer.errors.full_messages.to_sentence %></div><% end %><label>Name<%= form.text_field :name, required: true %></label><label>Email<%= form.email_field :email, required: true %></label><div class="form-grid"><label>Company<%= form.text_field :company %></label><label>Phone<%= form.telephone_field :phone %></label></div><%= form.submit class: "button" %><% end %>
