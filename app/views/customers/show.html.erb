<div class="page-head"><div><p class="eyebrow"><%= @customer.company %></p><h1><%= @customer.name %></h1><p><%= @customer.email %> · <%= @customer.phone %></p></div><%= link_to "Edit profile", edit_customer_path(@customer), class: "button button-secondary" %></div><section class="panel"><div class="section-head"><h2>Customer tickets</h2><%= link_to "New ticket", new_ticket_path(ticket: { customer_id: @customer.id }) %></div><%= inline_partial("tickets/_table", tickets: @customer.tickets.order(created_at: :desc)) %></section>
